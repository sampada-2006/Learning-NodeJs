<%-include('partials/head') %>
</head>

<body class="font-['Arial'] m-0 p-0 bg-[#f5f5f5]">

 <%-include('partials/nav') %>
  <main class="text-center py-20 px-8 bg-white shadow-[0_4px_8px_rgba(0,0,0,0.1)] my-8 mx-auto max-w-[600px] rounded-lg">

    <h2 class="text-[#333] text-4xl">
      Here are your registered homes:
    </h2>
     <ul>
      <% registerdHomes.forEach(home => {%>
        <div class="bg-white border border-gray-300 rounded-xl shadow-md overflow-hidden w-full max-w-sm hover:shadow-xl transition-shadow duration-300">

  <div class="p-6">
    <div>
      <img
  src="<%= home.imageurl %>"
  alt="<%= home.houseName %>"
  class="w-full h-52 object-cover"
/>
     </div>
    <h2 class="text-2xl font-bold text-gray-800 mb-5">
      <%= home.houseName %>
    </h2>
    
    <div class="space-y-4">

      <div>
        <p class="text-sm text-gray-500">Price per night</p>
        <p class="text-xl font-bold text-[#ff5a5f]">
          ₹<%= home.pricePerNight %>
        </p>
      </div>

      <div>
        <p class="text-sm text-gray-500">Location</p>
        <p class="text-lg font-medium text-gray-800">
          <%= home.location %>
        </p>
      </div>

      <div>
        <p class="text-sm text-gray-500">Rating</p>
        <p class="text-lg font-semibold text-gray-800">
          ⭐ <%= home.rating %>
        </p>
      </div>

    </div>

  </div>

</div>
      <%}) %>
     </ul>
  </main>

</body>
</html>