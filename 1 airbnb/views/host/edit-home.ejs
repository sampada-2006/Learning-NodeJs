<%- include('../partials/head') %>
  </head>
  <body class="font-['Arial'] m-0 p-0 bg-[#f5f5f5]">
    <%- include('../partials/nav') %>
    <main
      class="text-center py-20 px-8 bg-white shadow-[0_4px_8px_rgba(0,0,0,0.1)] my-8 mx-auto max-w-[600px] rounded-lg"
    >
    <h1 class="text-[#ff5a5f] text-4xl"><%= editing ? "Edit Your Home on AirBnB" : "Register Your Home on AirBnB"%></h1>
      <form
        action="/host/<%=editing ? "edit-home" : "add-home" %>" 
        method="POST"
        class="flex flex-col items-center gap-5"
      >
       
      <input type="hidden" name="id" value="<%= editing ? home.id : '' %>"/>

        <input
          type="text"
          name="houseName"
          value="<%= editing ? home.houseName : '' %>"
          placeholder="Enter the name of your house"
          class="w-full px-4 py-3 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-[#ff5a5f]"
        />
        <input
  type="text"
  value="<%= editing ? home.pricePerNight : '' %>"
  placeholder="Enter Price Per Night"
  name="pricePerNight"
  class="w-full px-4 py-3 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-[#ff5a5f]"
/>

<input
  type="text"
  value="<%= editing ? home.location : '' %>"
  placeholder="Enter Location"
  name="location"
  class="w-full px-4 py-3 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-[#ff5a5f]"
/>

<input
  type="text"
  value="<%= editing ? home.rating : '' %>"
  placeholder="Enter Rating"
  name="rating"
  class="w-full px-4 py-3 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-[#ff5a5f]"
/>

<input
  type="text"
  value="<%= editing ? home.imageurl : '' %>"
  name="imageurl"
  placeholder="Enter Image URL"
  class="w-full px-4 py-3 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-[#ff5a5f]"
/>
        <input
          type="submit"
          value="<%= editing ? "Update Home" : "Add Home" %>"
          class="bg-[#ff5a5f] text-white font-bold px-6 py-3 rounded-md cursor-pointer hover:bg-[#e54e52] transition-colors duration-300"
        />
      </form>
    </main>
  </body>
</html>
